<section class="card">
	<h2><%= title %></h2>
	<table class="table">
		<thead>
			<tr>
				<th>SKU</th>
				<th>Name</th>
				<th>Supplier</th>
				<th>Unit Price</th>
				<th>Cost Price</th>
			</tr>
		</thead>
		<tbody>
			<% items.forEach(it => { %>
			<tr>
				<td><%= it.sku %></td>
				<td><%= it.name %></td>
				<td><%= it.supplier_name || '-' %></td>
				<td>$<%= it.unit_price.toFixed(2) %></td>
				<td>$<%= it.cost_price.toFixed(2) %></td>
			</tr>
			<% }) %>
		</tbody>
	</table>
</section>